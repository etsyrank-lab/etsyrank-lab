# Phase 3 — live Etsy Open API v3 (optional; the app falls back to mock data
# when these are missing, so local dev and the demo deploy keep working).
#
# Get both from https://www.etsy.com/developers/your-apps after your app is approved.
# Auth header format (REQUIRED by Etsy since Feb 2026 — bare keystring returns 403):
#   x-api-key: <keystring>:<shared_secret>
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# MongoDB for keyword cache / credit ledger (Phase 4)
MONGODB_URI=mongodb://localhost:27017/etsyrank-lab

# AI provider for title/tag/description generation (pick one, Phase 4)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000
