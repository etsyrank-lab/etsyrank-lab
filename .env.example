# Phase 3 — live Etsy Open API v3 (optional; the app falls back to mock data
# when these are missing, so local dev and the demo deploy keep working).
#
# Get both from https://www.etsy.com/developers/your-apps after your app is approved.
# Auth header format (REQUIRED by Etsy since Feb 2026 — bare keystring returns 403):
#   x-api-key: <keystring>:<shared_secret>
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# MongoDB for keyword cache / credit ledger (Phase 4)
MONGODB_URI=mongodb://localhost:27017/etsyrank-lab

# AI provider for title/tag/description generation (pick one, Phase 4)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# Google Ads API — real search volumes via Keyword Planner (Phase 4).
# FREE: the API has no per-call charges; access is granted through your
# Google Cloud project's access level. NOTE: Keyword Planner calls REQUIRE
# Basic access (Google explicitly blocks planning services at Explorer level).
# Path: Test (automatic) -> Explorer (apply, usually automatic) -> complete
# brand verification (OAuth consent screen: External, published "In production",
# branding filled) -> apply for Basic (auto-approved in minutes after verification).
# If the "Apply for next access level" section is missing, attach a billing
# account to the project first (Billing page; card required, $0 charges —
# free-trial/disabled billing projects are refused).
# How to get each value, step by step:
#  1. Google Cloud Console (console.cloud.google.com): create a project,
#     enable the "Google Ads API", then open the Google Ads API Overview page
#     and apply for Explorer/Basic access (Explorer is usually automatic).
#  2. Create a free Google Ads account at ads.google.com (no spend needed)
#     and copy your 10-digit Customer ID (top right, no dashes).
#  3. Cloud Console -> APIs & Services -> OAuth consent screen (External, add
#     yourself as a test user) -> Credentials -> Create -> OAuth client ID ->
#     "Desktop app". Copy the client ID and secret.
#  4. Get a refresh token free via the OAuth 2.0 Playground
#     (developers.google.com/oauthplayground): settings -> "use your own OAuth
#     credentials", authorize the scope
#     https://www.googleapis.com/auth/adwords, then "Exchange authorization
#     code for tokens" and copy the refresh token.
#  5. Paste the five values below into Vercel -> Environment Variables and redeploy.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional: only if you query through a manager (MCC) account.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional legacy: only if your setup still demands a developer token
# (Google sunset these in Sept 2026 - most new setups don't need it).
# GOOGLE_ADS_DEVELOPER_TOKEN=
